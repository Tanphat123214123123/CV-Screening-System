# Copy sang .env (hoac khai bao truc tiep trong moi truong deploy) va dieu chinh gia tri.
# Xem chi tiet trong backend/src/main/resources/application.yml va README.md muc "Trien khai AWS that".

# --- Profile ---
# De trong khi dev. Deploy that: prod -> bo moi gia tri mac dinh, thieu secret thi khong khoi dong.
# SPRING_PROFILES_ACTIVE=prod

# --- Database ---
DB_HOST=localhost
# Cong 5433 (khong phai 5432 mac dinh): infra/docker-compose.yml map Postgres
# ra 5433 vi nhieu may da co san mot PostgreSQL native chiem san cong 5432.
DB_PORT=5433
DB_NAME=cvscreening
DB_USER=postgres
DB_PASSWORD=postgres

# --- JWT ---
# BAT BUOC doi khi deploy that: toi thieu 32 byte ngau nhien. Profile prod tu choi khoi dong
# neu van dung gia tri mac dinh duoi day.
JWT_SECRET=cv-screening-secret-key-change-me-in-production-2026
JWT_EXPIRATION=86400000

# --- Dang ky tai khoan nha tuyen dung ---
# Ma moi bat buoc khi dang ky HR. De trong = tat dang ky HR cong khai (mac dinh o profile prod).
HR_INVITE_CODE=HR-DEMO-2026

# --- AWS S3 / SQS ---
# Local dev: tro ve MinIO/ElasticMQ nhu ben duoi.
# Deploy AWS that: ĐỂ TRỐNG S3_ENDPOINT, SQS_ENDPOINT va ca 2 access key -> dung IAM role.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
# Host trinh duyet dung de mo presigned URL. Chi can khi backend chay trong Docker
# (S3_ENDPOINT=http://minio:9000 trinh duyet khong phan giai duoc). De trong = dung S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
SQS_ENDPOINT=http://localhost:9324
S3_BUCKET=cv-bucket
SQS_QUEUE=cv-processing-queue
# Dev: tu tao bucket/queue khi khoi dong. Production: false (tao bang IaC).
AWS_AUTO_CREATE_RESOURCES=true

# --- CORS ---
# Danh sach domain frontend duoc phep goi API, phan cach bang dau phay.
CORS_ORIGINS=http://localhost:5173
