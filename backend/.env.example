# Copy sang .env (hoac khai bao truc tiep trong moi truong deploy) va dieu chinh gia tri.
# Xem chi tiet trong backend/src/main/resources/application.yml va README.md muc "Trien khai AWS that".

# --- Database ---
DB_HOST=localhost
# Cong 5433 (khong phai 5432 mac dinh): infra/docker-compose.yml map Postgres
# ra 5433 vi nhieu may da co san mot PostgreSQL native chiem san cong 5432.
DB_PORT=5433
DB_NAME=cvscreening
DB_USER=postgres
DB_PASSWORD=postgres

# --- JWT ---
# BAT BUOC doi khi deploy that: toi thieu 32 ky tu ngau nhien, khong dung gia tri mac dinh.
JWT_SECRET=cv-screening-secret-key-change-me-in-production-2026
JWT_EXPIRATION=86400000

# --- AWS S3 / SQS ---
# Local dev: tro ve MinIO/ElasticMQ nhu ben duoi.
# Deploy AWS that: dat AWS_ACCESS_KEY_ID/SECRET that, ĐỂ TRỐNG S3_ENDPOINT va SQS_ENDPOINT.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
SQS_ENDPOINT=http://localhost:9324
S3_BUCKET=cv-bucket
SQS_QUEUE=cv-processing-queue

# --- CORS ---
# Danh sach domain frontend duoc phep goi API, phan cach bang dau phay.
CORS_ORIGINS=http://localhost:5173
