# Copy sang .env (hoac khai bao truc tiep trong moi truong deploy) va dieu chinh gia tri.
# Xem chi tiet trong ai-worker/app/config.py va README.md muc "Trien khai AWS that".

# --- AWS S3 / SQS ---
# Local dev: tro ve MinIO/ElasticMQ nhu ben duoi.
# Deploy AWS that: dat AWS_ACCESS_KEY_ID/SECRET that, ĐỂ TRỐNG S3_ENDPOINT va SQS_ENDPOINT.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
SQS_ENDPOINT=http://localhost:9324
S3_BUCKET=cv-bucket
SQS_QUEUE=cv-processing-queue

# --- Database (dung chung voi backend Spring Boot) ---
# Cong 5433 (khong phai 5432 mac dinh): xem ghi chu trong infra/docker-compose.yml
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/cvscreening

# --- LLM (tuy chon) ---
# Neu de trong, worker van chay binh thuong va dung nhan xet rule-based thay the.
ANTHROPIC_API_KEY=

POLL_WAIT_SECONDS=10
